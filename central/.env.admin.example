# Garra admin app — Supabase auth config.
# Copy to `central/.env.admin`, fill in, restart claw_next_admin and claw_fastapi.

# ─── Frontend (next-admin) ─────────────────────────────────────────────
# Public, baked into the client bundle. Get both from Supabase dashboard
# → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Base URL for backend admin API. Empty string means "same origin" — works
# with the nginx setup (admin.localhost proxies /admin/* to fastapi). Set
# to a full URL only for cross-host development.
NEXT_PUBLIC_ADMIN_API_BASE=

# ─── Backend (fastapi) ──────────────────────────────────────────────────
# Secret — DO NOT commit. From Supabase dashboard → Project Settings →
# API → JWT Settings → JWT Secret.
SUPABASE_JWT_SECRET=replace-me
# Optional — change only if you customized Supabase's audience claim.
SUPABASE_JWT_AUDIENCE=authenticated
# Optional, informational only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
