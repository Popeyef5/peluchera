# central/.env.prod — copy to .env.prod and fill in. Never commit the real thing.
#
# There are TWO env files, deliberately:
#   .env       DEV  — local Postgres (claw_db), BYPASS_PAYMENT=true. Read by
#                     docker-compose.dev.yml and the simulation suite.
#   .env.prod  PROD — Neon, FREE_PLAY=true. Read by docker-compose.yml and
#                     update.sh, and by nothing else.
#
# They are separate so a dev stack can never be pointed at the production
# database by accident. update.sh refuses outright if DATABASE_URL mentions
# claw_db.
#
# docker compose passes this to BOTH the backend and the Next build, which is why
# NEXT_PUBLIC_* live here too. Anything NEXT_PUBLIC_* is BAKED INTO THE JS BUNDLE
# at build time: changing one only takes effect after a rebuild (update.sh always
# rebuilds, so that's handled — but it's why they can never be runtime toggles).
#
# See DEPLOY.md for the pre-deploy checklist.

# ─── Mode ────────────────────────────────────────────────────────────────
# FREE_PLAY: everyone logs in for real (wallet / email / social — real account,
# real inventory, real payout address) but nobody pays. PLAY goes straight to the
# queue. Wins, boosters, cards, resells are all real; only the payment is skipped
# and withdrawals are simulated (no USDC leaves the treasury for a free play).
# Both paid rails refuse while this is on.
#
# Switch monetization on later: FREE_PLAY=false + restart the backend. NO frontend
# rebuild needed — the client is told at login.
FREE_PLAY=true

# BYPASS_PAYMENT is a DIFFERENT thing: demo mode, NO wallet at all, synthetic
# guest addresses. Nobody can log in as themselves. Dev + the sim use it.
# Leave this false in prod — FREE_PLAY is what you want.
BYPASS_PAYMENT=false
NEXT_PUBLIC_BYPASS_PAYMENT=false

# ─── Database ────────────────────────────────────────────────────────────
# Prod = Neon (project "cl4ws" (org "Cl4ws"), branch "production", database "neondb", aws-us-east-2, Postgres 18).
# There is NO db service in docker-compose.yml. Both strings come from the Neon
# console -> Connect; they differ only in the "-pooler" suffix on the host.
#
# DATABASE_URL: the POOLED endpoint (host has "-pooler"). The app uses it. It is
# a transaction-mode PgBouncer, which is fine: db.py turns off the driver's
# server-side prepared statements, and the code uses no SET / LISTEN / advisory
# locks. Going through the pooler also means no idle connection sits on the
# database, so it can scale to zero when nobody is playing.
DATABASE_URL="postgresql+psycopg://<ROLE>:<PASSWORD>@ep-<ENDPOINT>-pooler.c-<N>.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_DIRECT: the same endpoint WITHOUT "-pooler". Used only by
# migrations (alembic/env.py) and update.sh's pre-migration pg_dump, neither of
# which works properly through a transaction pooler.
DATABASE_URL_DIRECT="postgresql+psycopg://<ROLE>:<PASSWORD>@ep-<ENDPOINT>.c-<N>.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Free-plan budget: 100 CU-hours/project/month, after which the database is
# SUSPENDED until the 1st. At 0.25 CU that is 400 hours of the compute being
# awake. It only stays awake while something queries it, which is why the
# backend stays off the database when nobody is queued or playing
# (state.queue_known_empty). Keep autoscaling pinned to 0.25 CU.

# ─── Uploaded assets (pack art, card images, opening videos) ─────────────
# An S3-compatible bucket: Neon Object Storage on the production branch, bucket
# "assets", access public_read. Credentials: a Neon service credential with
# storage:read + storage:write. The admin panel uploads straight to it with a
# presigned PUT from POST /admin/uploads; players read the public URLs.
ASSETS_S3_ENDPOINT=
ASSETS_S3_REGION=us-east-2
ASSETS_S3_ACCESS_KEY_ID=
ASSETS_S3_SECRET_ACCESS_KEY=
ASSETS_BUCKET=assets
# Optional: serve reads from a CDN instead. Defaults to <endpoint>/<bucket>.
ASSETS_PUBLIC_BASE=

# ─── Money ───────────────────────────────────────────────────────────────
# Treasury: receives ticket payments, and pays out winnings. The address MUST be
# byte-identical in both vars or every crypto payment silently fails verification.
TREASURY_ADDRESS=0x...
NEXT_PUBLIC_TREASURY_ADDRESS=0x...
# Signs payouts from the treasury. Needs ETH for gas (+ USDC to pay winners).
# Falls back to CLAW_PRIVATE_KEY if unset.
TREASURY_PRIVATE_KEY=0x...

# Ticket price. These two must agree.
TICKET_PRICE_CENTS=1000
NEXT_PUBLIC_TICKET_PRICE_CENTS=1000

# USDC (Base Sepolia default).
USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Card money is reversible; USDC payouts are not. Winnings from a card-funded
# ticket aren't withdrawable until this many days after the charge.
CHARGEBACK_HOLD_DAYS=7

# ─── Card rail (Stripe) ──────────────────────────────────────────────────
# Not needed while FREE_PLAY=true — the card option auto-hides without them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Login (wallet provider: Reown or Privy) ─────────────────────────────
# WALLET_PROVIDER picks the wallet stack at RUNTIME (server-side, read in
# app/layout.tsx). reown (default) | privy. Swapping it is a `docker compose
# restart`, NOT a rebuild — but both providers' PUBLIC keys must already be baked
# into the build (see the next-app note below).
WALLET_PROVIDER=reown
#
# ⚠️  IMPORTANT: the PLAYER app's NEXT_PUBLIC_* (incl. NEXT_PUBLIC_PROJECT_ID and
# NEXT_PUBLIC_PRIVY_APP_ID) are NOT read from this file at build time — they are
# baked from `central/next/.env.production`. Put those two there, not here. (Only
# the admin app takes NEXT_PUBLIC_* from compose, via build args.)
#
# Reown: register the site's domain for NEXT_PUBLIC_PROJECT_ID in the Reown
# dashboard + enable Email/Google/Apple/X — a domain mismatch silently kills the
# social buttons. Privy: create an app at dashboard.privy.io, enable the same
# login methods, add the domains, and set NEXT_PUBLIC_PRIVY_APP_ID.
NEXT_PUBLIC_PROJECT_ID=

# Player sign-in (SIWX). Players sign a one-time message with their wallet and
# the server issues a 30-day session token signed with this secret. REQUIRED in
# prod: if unset, a random secret is generated per process and every player has
# to sign again after each restart or deploy. Generate with: openssl rand -hex 32
# Rotating it signs everyone out.
PLAYER_SESSION_SECRET=
# Hosts the player app is served from. A signature naming any other host is
# refused, so a lookalike site can't harvest sign-ins that work here.
PLAYER_AUTH_DOMAINS=cl4ws.com,www.cl4ws.com

# ─── Chain ───────────────────────────────────────────────────────────────
INFURA_API_KEY=
BASE_RPC_HTTP="https://base-sepolia.infura.io/v3/${INFURA_API_KEY}"
BASE_RPC_WS="wss://base-sepolia.infura.io/ws/v3/${INFURA_API_KEY}"
CHAIN_ID=84532
# The escrow contract is RETIRED (pay/win/balance/withdraw are all off-chain).
# Kept only because dead code still imports it.
CLAW_CONTRACT_ADDRESS=0x...
CLAW_PRIVATE_KEY=0x...

# ─── Cabinet ─────────────────────────────────────────────────────────────
PI_SERVER_URL=http://<pi-host>:5000

# ─── Admin panel sign-in (Neon Auth, production branch) ─────────────────
# Operators sign in with an emailed code or Google; FastAPI verifies the
# resulting JWT. Unset NEON_AUTH_BASE_URL → every /admin call 503s. The game
# still runs fine. Both are read at runtime (FastAPI and next-admin), so no
# rebuild after changing them.
#   NEON_AUTH_BASE_URL      — Console → Auth → Configuration
#   NEON_AUTH_COOKIE_SECRET — `openssl rand -base64 32`; signs next-admin's
#                             cached session cookie. Rotating it only forces a
#                             session re-check, nobody is signed out.
NEON_AUTH_BASE_URL=https://ep-<endpoint>.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=
#
# Admin access allow-list. Neon Auth sign-up is open, so a sign-in proves an
# identity, not an operator. These decide who is an operator, and the email
# must also be verified (code or Google). With BOTH empty, NOBODY gets in.
#   ADMIN_EMAIL_ALLOWLIST — comma-separated exact emails
#   ADMIN_EMAIL_DOMAINS   — comma-separated domains, e.g. cl4ws.com
ADMIN_EMAIL_ALLOWLIST=
ADMIN_EMAIL_DOMAINS=
# Before real use: add your own Google OAuth client (redirect URI
# <NEON_AUTH_BASE_URL>/callback/google) and custom SMTP in Console → Auth.
# The shared Google app and shared sender are for development.

# ─── Ops ─────────────────────────────────────────────────────────────────
DOMAIN_NAME=
EMAIL=
CERTBOT_ETC_VOL=claw_certbot_etc
CERTBOT_WWW_VOL=claw_certbot_www
COMPOSE_DIR=~/peluchera/central
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_CHAT_INFO=
# Telegram alerts are OFF by default. Set true (with token+chat above) to enable.
TELEGRAM_ALERTS=false

# ─── Analytics (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
